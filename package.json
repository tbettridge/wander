{
  "name": "wander-living-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An experimental WANDER branch for browser-native, on-device narrative AI.",
  "scripts": {
    "serve": "python3 -m http.server 8474",
    "test": "node --test tests/*.mjs",
    "playtest": "python3 -m http.server 8474",
    "playtest:score": "node scripts/summarize-npc-playtest.mjs",
    "playtest:interiors": "node scripts/playtest-interiors.mjs",
    "playtest:shelter": "node scripts/playtest-shelter.mjs",
    "playtest:courier": "node scripts/playtest-courier.mjs",
    "playtest:names": "node scripts/playtest-spoken-names.mjs",
    "playtest:multiplayer": "node scripts/playtest-multiplayer.mjs",
    "sim:animal-track": "node --import ./scripts/animal-track/register.mjs scripts/animal-track/simulate.mjs",
    "playbot": "node scripts/playbot-courier.mjs",
    "playbot:setup": "npm install --prefix .playbot --no-audit --no-fund playwright-core@1.63 @sparticuz/chromium@153.0.0 three@0.185.0 tone@14.7.77"
  }
}
